# Copy to .env next to docker-compose.yml and adjust.

# Image built by the "zofi-docker" GitHub workflow. Pin a version; do not use :latest in production.
ZOFIDESK_IMAGE=ghcr.io/zofitax/zofidesk-server:0.1.0

# Public name of this server; Caddy gets its HTTPS certificate for it.
ZOFIDESK_DOMAIN=zigno.zofi.tax

# Relay address handed to the clients.
RELAY_SERVERS=zigno.zofi.tax:21117

# N while migrating: installed clients keep working without an account.
# Set to Y once the technicians have accounts and ZofiDesk clients with login.
MUST_LOGIN=N
